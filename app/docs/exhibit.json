{
  "/exhibits": {
    "post": {
      "summary": "Create exhibit",
      "tags": ["Exhibits"],
      "security": [{ "bearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "required": ["categoryId"],
              "properties": {
                "title": {
                  "type": "string",
                  "format": "string",
                  "example": "Exhibit #1"
                },
                "categoryId": {
                  "type": "string",
                  "format": "uuid"
                },
                "model": {
                  "type": "string",
                  "format": "binary"
                },
                "images": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Exhibit created"
        },
        "401": {
          "description": "Unauthorized"
        },
        "403": {
          "description": "Forbidden"
        }
      }
    },
    "get": {
      "summary": "Get exhibits",
      "tags": ["Exhibits"],
      "parameters": [
        {
          "in": "query",
          "name": "category",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "in": "query",
          "name": "locale",
          "schema": {
            "type": "string",
            "example": "ua"
          }
        },
        {
          "in": "query",
          "name": "search",
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "query",
          "name": "page",
          "schema": {
            "type": "integer",
            "default": 1
          }
        },
        {
          "in": "query",
          "name": "limit",
          "schema": {
            "type": "integer",
            "default": 20
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Exhibits list"
        }
      }
    }
  },
  "/exhibits/{id}": {
    "get": {
      "summary": "Get exhibit by ID",
      "tags": ["Exhibits"],
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "in": "query",
          "name": "locale",
          "required": false,
          "schema": {
            "type": "string",
            "example": "ua"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Exhibit object"
        },
        "404": {
          "description": "Exhibit not found"
        }
      }
    },
    "put": {
      "summary": "Update exhibit",
      "tags": ["Exhibits"],
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "categoryId": {
                  "type": "string",
                  "format": "uuid"
                },
                "model": {
                  "type": "string",
                  "format": "binary"
                },
                "images": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Exhibit updated"
        },
        "401": {
          "description": "Unauthorized"
        },
        "403": {
          "description": "Forbidden"
        }
      }
    },
    "delete": {
      "summary": "Delete exhibit",
      "tags": ["Exhibits"],
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Exhibit deleted"
        },
        "401": {
          "description": "Unauthorized"
        },
        "403": {
          "description": "Forbidden"
        }
      }
    }
  },
  "/exhibits/{id}/translation": {
    "post": {
      "summary": "Create or update exhibit translation",
      "tags": ["Exhibits"],
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["locale"],
              "properties": {
                "locale": {
                  "type": "string",
                  "example": "ua"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "creationPeriod": {
                  "type": "string"
                },
                "author": {
                  "type": "string"
                },
                "materials": {
                  "type": "string"
                },
                "creationMethod": {
                  "type": "string"
                },
                "fact": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Translation saved"
        },
        "401": {
          "description": "Unauthorized"
        },
        "404": {
          "description": "Exhibit not found"
        }
      }
    }
  },
  "/exhibits/{id}/translation/{locale}": {
    "put": {
      "summary": "Update exhibit translation",
      "tags": ["Exhibits"],
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "in": "path",
          "name": "locale",
          "required": true,
          "schema": {
            "type": "string",
            "example": "ua"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "description": { "type": "string" },
                "creationPeriod": { "type": "string" },
                "author": { "type": "string" },
                "materials": { "type": "string" },
                "creationMethod": { "type": "string" },
                "fact": { "type": "string" },
                "location": { "type": "string" },
                "owner": { "type": "string" }
              }
            }
          }
        }
      },
      "responses": {
        "200": { "description": "Translation updated" },
        "400": { "description": "Bad request" },
        "401": { "description": "Unauthorized" },
        "404": { "description": "Translation not found" }
      }
    },

    "delete": {
      "summary": "Delete exhibit translation",
      "tags": ["Exhibits"],
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "in": "path",
          "name": "locale",
          "required": true,
          "schema": {
            "type": "string",
            "example": "ua"
          }
        }
      ],
      "responses": {
        "200": { "description": "Translation deleted successfully" },
        "401": { "description": "Unauthorized" },
        "403": { "description": "Forbidden" },
        "404": { "description": "Translation not found" }
      }
    }
  }
}
