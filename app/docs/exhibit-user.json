{
  "/user-exhibits/images": {
    "get": {
      "summary": "Get all user generated images (for current user)",
      "tags": ["Exhibit User Images"],
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        {
          "in": "query",
          "name": "page",
          "schema": {
            "type": "integer",
            "default": 1
          }
        },
        {
          "in": "query",
          "name": "limit",
          "schema": {
            "type": "integer",
            "default": 20
          }
        },
        {
          "in": "query",
          "name": "search",
          "schema": {
            "type": "string"
          },
          "description": "Search by exhibit title"
        }
      ],
      "responses": {
        "200": {
          "description": "List of user generated exhibits with images"
        },
        "401": {
          "description": "Unauthorized"
        }
      }
    }
  },
  "/user-exhibits/images/{exhibitId}": {
    "get": {
      "summary": "Get user generated images for specific exhibit",
      "tags": ["Exhibit User Images"],
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        {
          "in": "path",
          "name": "exhibitId",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "in": "query",
          "name": "page",
          "schema": {
            "type": "integer",
            "default": 1
          }
        },
        {
          "in": "query",
          "name": "limit",
          "schema": {
            "type": "integer",
            "default": 20
          }
        },
        {
          "in": "query",
          "name": "search",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Exhibit with user generated images"
        },
        "404": {
          "description": "Exhibit not found"
        }
      }
    },
    "post": {
      "summary": "Create user generated image for exhibit",
      "tags": ["Exhibit User Images"],
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        {
          "in": "path",
          "name": "exhibitId",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "generations": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "required": ["generations"]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Image created"
        },
        "401": {
          "description": "Unauthorized"
        }
      }
    },
    "put": {
      "summary": "Update user generated image",
      "tags": ["Exhibit User Images"],
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        {
          "in": "path",
          "name": "exhibitId",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "requestBody": {
        "required": false,
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "generations": {
                  "type": "string",
                  "format": "binary"
                },
                "exhibitId": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Image updated"
        },
        "404": {
          "description": "Not found"
        }
      }
    },
    "delete": {
      "summary": "Delete user generated image",
      "tags": ["Exhibit User Images"],
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        {
          "in": "path",
          "name": "exhibitId",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Deleted successfully"
        },
        "404": {
          "description": "Not found"
        }
      }
    }
  },
  "/user-exhibits/images/{exhibitId}/{imageId}": {
    "delete": {
      "summary": "Delete all user generated images for exhibit",
      "tags": ["Exhibit User Images"],
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        {
          "in": "path",
          "name": "exhibitId",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Exhibit ID"
        },
        {
          "in": "path",
          "name": "imageId",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Image ID"
        }
      ],
      "responses": {
        "200": {
          "description": "All user images for exhibit deleted successfully"
        },
        "401": {
          "description": "Unauthorized"
        },
        "404": {
          "description": "User images not found"
        }
      }
    }
  }
}
